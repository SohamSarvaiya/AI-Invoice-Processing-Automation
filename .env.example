# --- copy to .env ---
POSTGRES_PASSWORD=change-me
API_KEY=change-this-long-random-string

# Extraction: auto = use an AI if any key below is set, else rule-based. llm = AI only. rules = offline only.
EXTRACTION_MODE=auto
# AI provider: auto = first key found, or force one of: anthropic (Claude) | openai (ChatGPT) | gemini (Google)
# You can also skip all of this and paste the client's key live in the review screen (⚙ button).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
GEMINI_MODEL=gemini-3.5-flash
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low              # blank it if you switch to an older model that rejects it
LLM_MAX_TOKENS=8000

# Validation / policy
AMOUNT_TOLERANCE=0.05
HIGH_VALUE_THRESHOLD=500000
MAX_INVOICE_AGE_DAYS=365
ALLOWED_CURRENCIES=INR,USD,EUR,GBP
DATE_DAYFIRST=true
AUTO_APPROVE_LIMIT=0        # 0 = every invoice needs a human click

# Retry
MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1

# ROI report assumptions (tune per client)
MANUAL_MINUTES_PER_INVOICE=8
REVIEW_MINUTES_PER_INVOICE=2
CORRECTION_MINUTES_PER_INVOICE=6
HOURLY_COST=300
